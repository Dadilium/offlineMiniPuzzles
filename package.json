{
  "name": "puzzle-den",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "typecheck:tools": "tsc --noEmit -p tools/tsconfig.json",
    "levels": "tsx tools/level-creator/cli.ts",
    "i18n:check": "tsx tools/i18n-check/cli.ts",
    "update:development": "eas update --branch development",
    "update:preview": "eas update --branch preview",
    "update:production": "eas update --branch production"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@sentry/react-native": "^8.21.0",
    "expo": "~51.0.0",
    "expo-application": "~5.9.1",
    "expo-build-properties": "~0.12.5",
    "expo-dev-client": "~4.0.29",
    "expo-localization": "~15.0.3",
    "expo-splash-screen": "~0.27.7",
    "expo-status-bar": "~1.12.1",
    "expo-tracking-transparency": "~4.0.2",
    "expo-updates": "~0.25.28",
    "i18next": "^26.3.6",
    "posthog-react-native": "^4.61.2",
    "react": "18.2.0",
    "react-i18next": "^17.0.11",
    "react-native": "0.74.5",
    "react-native-google-mobile-ads": "^14.2.3",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/node": "^26.1.1",
    "@types/react": "~18.2.79",
    "patch-package": "^8.0.1",
    "tsx": "^4.23.1",
    "typescript": "~5.3.3"
  }
}
