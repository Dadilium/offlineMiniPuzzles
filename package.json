{
  "name": "puzzle-den",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "typecheck:tools": "tsc --noEmit -p tools/tsconfig.json",
    "levels": "tsx tools/level-creator/cli.ts",
    "i18n:check": "tsx tools/i18n-check/cli.ts",
    "update:development": "eas update --branch development",
    "update:preview": "eas update --branch preview",
    "update:production": "eas update --branch production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "@sentry/react-native": "^8.22.0",
    "expo": "57",
    "expo-application": "~57.0.2",
    "expo-build-properties": "~57.0.9",
    "expo-constants": "~57.0.9",
    "expo-dev-client": "~57.0.10",
    "expo-font": "~57.0.1",
    "expo-localization": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-tracking-transparency": "~57.0.1",
    "expo-updates": "~57.0.12",
    "i18next": "^26.3.6",
    "posthog-react-native": "^4.62.0",
    "react": "19.2.3",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.2",
    "react-native-google-mobile-ads": "^16.4.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "babel-preset-expo": "~57.0.6",
    "@babel/core": "^7.29.0",
    "@types/node": "^26.1.1",
    "@types/react": "~19.2.0",
    "patch-package": "^8.0.1",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    }
  }
}
