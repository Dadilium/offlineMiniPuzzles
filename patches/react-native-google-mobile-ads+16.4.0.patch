+// Scene-aware lookup of the window ads should present from. With the UIKit
+// scene lifecycle (Expo `ios.enableSceneSupport`, default from SDK 58),
+// `UIApplication.keyWindow` is deprecated and isn't guaranteed to return the
+// active window -- presenting from the wrong one leaves full-screen ads (and
+// the alerts they raise, like "close video?") unable to dismiss. Prefers the
+// key window of the foreground-active scene, then the app delegate's window
+// (Expo mirrors the scene window onto it), then the legacy `keyWindow`.
++ (UIWindow *)activeWindow {
+  UIApplication *application = [UIApplication sharedApplication];
+  if (@available(iOS 13.0, *)) {
+    for (UIScene *scene in application.connectedScenes) {
+      if (scene.activationState != UISceneActivationStateForegroundActive ||
+          ![scene isKindOfClass:[UIWindowScene class]]) {
+        continue;
+      }
+      UIWindowScene *windowScene = (UIWindowScene *)scene;
+      if (@available(iOS 15.0, *)) {
+        if (windowScene.keyWindow) {
+          return windowScene.keyWindow;
+        }
+      }
+      for (UIWindow *window in windowScene.windows) {
+        if (window.isKeyWindow) {
+          return window;
+        }
+      }
+    }
+  }
+  if ([application.delegate respondsToSelector:@selector(window)] && application.delegate.window) {
+    return application.delegate.window;
+  }
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+  return application.keyWindow;
+#pragma clang diagnostic pop
+}
