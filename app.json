{
  "expo": {
    "name": "Signal Arcade",
    "slug": "puzzlegame",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#05060a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.converge.signalarcade",
      "infoPlist": {
        "CFBundleLocalizations": [
          "en",
          "fr",
          "en",
          "fr"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "io.converge.signalarcade"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-localization",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "puzzlegame",
          "organization": "antoine-roy"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.0"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0eb3a149-21b2-4db4-9d58-449760426e87"
      }
    },
    "owner": "dadiliums-team"
  }
}
