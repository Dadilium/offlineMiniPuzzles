{
  "expo": {
    "name": "Puzzle Den",
    "slug": "puzzlegame",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0eb3a149-21b2-4db4-9d58-449760426e87",
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_ERROR_RECOVERY"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.antoineroy.puzzleden",
      "infoPlist": {
        "CFBundleLocalizations": [
          "en",
          "fr",
          "en",
          "fr"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.antoineroy.puzzleden",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#0f131d"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-localization",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/adaptive-icon-foreground.png",
          "resizeMode": "contain",
          "backgroundColor": "#0f131d"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "puzzlegame",
          "organization": "antoine-roy"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "This identifier is used to show you ads that are more relevant to your interests."
        }
      ],
      [
        "react-native-google-mobile-ads/app.plugin.js",
        {
          "androidAppId": "ca-app-pub-2631204280172241~3792617336",
          "iosAppId": "ca-app-pub-2631204280172241~3357503060"
        }
      ],
      "./plugins/withKotlinSkipMetadataVersionCheck.js"
    ],
    "extra": {
      "eas": {
        "projectId": "0eb3a149-21b2-4db4-9d58-449760426e87"
      }
    },
    "owner": "dadiliums-team"
  }
}
